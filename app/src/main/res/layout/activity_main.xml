<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/headless_bg">

    <!-- Real WebView (visible when headless OFF) -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- Headless overlay screen -->
    <LinearLayout
        android:id="@+id/headless_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/headless_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_headless_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/headless_label"
            android:textColor="@color/headless_text"
            android:textSize="42sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_headless_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/headless_on"
            android:textColor="#AAAAAA"
            android:textSize="22sp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tv_headless_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Bridge · 8765"
            android:textColor="#666666"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Settings gear icon (always on top) -->
    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        android:scaleType="fitCenter"
        android:elevation="8dp" />

</FrameLayout>
